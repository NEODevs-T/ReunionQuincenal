    protected async Task Get()
    {
        Status = Uri.UnescapeDataString(Status ?? string.Empty);
        Status = ValidationMessages.MapStatusKey((Status ?? string.Empty).Trim());

        if (IdCentro != 0 && IdDiv != 0)
        {
            if (dataIsLoaded != 1)
            {
                dataIsLoaded = 1;

                // === Consulta al backend (igual que en Pendiente): Vencidos/TotalPendiente son "visuales" -> se consulta "Todo"
            var statusConsulta = Status;
            if (EsOpcionVencidosGenerico(statusConsulta) || EsOpcionTotalPendiente(statusConsulta))
                statusConsulta = "Todo";

            statusConsulta = ValidationMessages.MapStatusKey(statusConsulta ?? string.Empty);

            // 🔥 NECESARIO PARA QUE "Pendiente/Responsable" FUNCIONE
            var statusConsultaSegment = Uri.EscapeDataString(statusConsulta);

            await PizarraData.GetPendientes(
                IdCentro.ToString(),
                IdDiv.ToString(),
                fecha1,
                fecha2,
                tipoconsulta,
                statusConsultaSegment
            );

                // === Mismos pasos que en Pendiente ===
                ObtenerReunionesPorRol();

                if (IdMasterSeleccionado > 0)
                {
                    listareu = listareu.Where(r => r.IdMaster == IdMasterSeleccionado).ToList();
                }

                var stSel = ValidationMessages.MapStatusKey(Status ?? string.Empty);

                // 2.1) VENCIDAS DIARIA (nuevo filtro específico)
                // => solo "pendientes vencidos" con KSF=6
                if (stSel.Equals("VencidasDiaria", StringComparison.OrdinalIgnoreCase))
                {
                    listareu = listareu
                        .Where(d => d.Idksf == 6 && EsVencidoGeneral(d)) // pendiente + fecha < hoy
                        .ToList();
                }
                else if (stSel.Equals("Vencidos", StringComparison.OrdinalIgnoreCase))
                {
                    // 2.2) VENCIDOS (como en Pendiente.txt) PERO separado del diario
                    // => solo "pendientes vencidos" EXCLUYENDO KSF=6
                    listareu = listareu
                        .Where(d => EsVencidoGeneral(d) && d.Idksf != 6)
                        .ToList();
                }
                else if (EsOpcionTotalPendiente(stSel))
                {
                    // 2.3) TOTAL PENDIENTE (idéntico a Pendiente.txt)
                    // => estado ORIGINAL que empieza por "Pendiente"
                    listareu = listareu
                        .Where(d => (ValidationMessages.MapStatusKey(d.Rdstatus ?? string.Empty))
                                    .StartsWith("Pendiente", StringComparison.OrdinalIgnoreCase))
                        .ToList();
                }
                // resto de estados: sin filtro adicional aquí (igual que en Pendiente.txt)

                // === Catálogo y filtro por equipo (se mantiene como en tu código)
                ConstruirCatalogoEquiposPorNombre();
                AplicarFiltroPorCodigoSeleccionado();

                // === Regla "permite vencidos" (idéntica a Pendiente.txt, con VencidasDiaria añadida)
                var permiteVencidos =
                    stSel.Equals("Vencidos", StringComparison.OrdinalIgnoreCase)
                    || stSel.Equals("VencidasDiaria", StringComparison.OrdinalIgnoreCase)   // ← NUEVO
                    || EsOpcionTotalPendiente(stSel)
                    || ValidationMessages.MapStatusKey("Todo").Equals(stSel, StringComparison.OrdinalIgnoreCase);

                if (!permiteVencidos)
                {
                    // Quita registros que, "visual/effective", quedaron como vencidos
                    var VencidosKey = ValidationMessages.MapStatusKey("Vencidos");
                    var VediKey     = ValidationMessages.MapStatusKey("VencidasDiaria");

                    listareu = listareu
                        .Where(d =>
                        {
                            var ef = ValidationMessages.MapStatusKey(EstadoEfectivo(d) ?? string.Empty);
                            return !ef.Equals(VencidosKey, StringComparison.OrdinalIgnoreCase)
                                && !ef.Equals(VediKey, StringComparison.OrdinalIgnoreCase);
                        })
                        .ToList();
                }
                dataIsLoaded = 2;
            }
        }
        else
        {
            NotificationService.Notify(Notificar.Notificacion(
                "advertencia",
                DiccionarioTraduccionesService.Traducciones["Atencion"],
                DiccionarioTraduccionesService.Traducciones["SVLista"]
            ));
        }
    }


