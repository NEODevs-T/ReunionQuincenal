                    // Actualiza la lista en memoria según rol
                    ObtenerReunionesPorRol();
                    ConstruirCatalogoEquiposPorNombre();
                    AplicarFiltroPorCodigoSeleccionado();

                    // Filtro por línea (si aplica)
                    if (IdMasterSeleccionado > 0)
                    {
                        listareu = listareu
                            .Where(r => r.IdMaster == IdMasterSeleccionado)
                            .ToList();
                    }

                    // 3) Aplica el filtro VISUAL de vencidos en cliente
                    AplicarFiltroVisualDeVencidos();

                    dataIsLoaded = 2;
                }
                else
                {
                    // Cuando hay ODT en localStorage, conserva el flag visual y busca por ODT
                    valuvisualeodt = valueodt;
                    await BuscarxOdt();

                    // Aplica el mismo filtro/orden tras la búsqueda por ODT, para coherencia
                    AplicarFiltroVisualDeVencidos();
                }
            }
        }
        catch (Exception ex)
        {
            // Puedes loguear ex para diagnóstico
            NotificationService.Notify(Notificar.Notificacion(
                "error",
                DiccionarioTraduccionesService.Traducciones["ErrorInesp"],
                DiccionarioTraduccionesService.Traducciones["Reload"]));
        }
    }

    private void AplicarFiltroVisualDeVencidos()
    {
        var stSel = ValidationMessages.MapStatusKey(Status ?? string.Empty);

        if (stSel.Equals("VencidasDiaria", StringComparison.OrdinalIgnoreCase))
        {
            listareu = listareu
                .Where(d => d.Idksf == 6 && EsVencidoGeneral(d))
                .ToList();
        }
        else if (stSel.Equals("Vencidos", StringComparison.OrdinalIgnoreCase))
        {
            listareu = listareu
                .Where(d => EsVencidoGeneral(d) && d.Idksf != 6)
                .ToList();
        }
        else if (EsOpcionTotalPendiente(stSel))
        {
            listareu = listareu
                .Where(d => (ValidationMessages.MapStatusKey(d.Rdstatus ?? string.Empty))
                            .StartsWith("Pendiente", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        // Regla "permite vencidos" (igual que en Get)
        var permiteVencidos =
            stSel.Equals("Vencidos", StringComparison.OrdinalIgnoreCase)
            || stSel.Equals("VencidasDiaria", StringComparison.OrdinalIgnoreCase)
            || EsOpcionTotalPendiente(stSel)
            || ValidationMessages.MapStatusKey("Todo").Equals(stSel, StringComparison.OrdinalIgnoreCase);

        if (!permiteVencidos)
        {
            var VencidosKey = ValidationMessages.MapStatusKey("Vencidos");
            var VediKey     = ValidationMessages.MapStatusKey("VencidasDiaria");

            listareu = listareu
                .Where(d => {
                    var ef = ValidationMessages.MapStatusKey(EstadoEfectivo(d) ?? string.Empty);
                    return !ef.Equals(VencidosKey, StringComparison.OrdinalIgnoreCase)
                        && !ef.Equals(VediKey, StringComparison.OrdinalIgnoreCase);
                })
                .ToList();
        }
    }

    // Parseo seguro de fecha de ruta "dd-MM-yyyy"
    private static bool TryParseFechaRuta(string? s, out DateTime result)
    {
        return DateTime.TryParseExact(
            s ?? string.Empty,
            "dd-MM-yyyy",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None,
            out result
        );
    }

    public void ObtenerReunionesPorRol()
    {
        var fuente = PizarraData.reudiatablas ?? new List<ReunionDTO>();

        if (!string.IsNullOrWhiteSpace(UsrRol))
        {
            var rol = UsrRol.Trim();

            listareu = fuente
                .Where(r =>
                    r != null
                    && (
                        // 1) Si el texto de Responsable viene en el DTO, úsalo
                        (!string.IsNullOrWhiteSpace(r.Responsable)
                            ? r.Responsable.Trim().StartsWith(rol, StringComparison.OrdinalIgnoreCase)
                            // 2) Si viene vacío, mira el catálogo por IdResReu
                            : EsResponsable(r.IdResReu, rol)
                        )
                    )
                )
                .ToList();
        }
        else
        {
            listareu = fuente;
        }
    }

    private bool EsResponsable(int idResReu, string rol)
    {
        var resp = RespoReuData.resporeus?.FirstOrDefault(x => x.IdResReu == idResReu);
        var nombre = (idPais == 5 ? resp?.Rrenglish : resp?.Rrnombre)?.Trim();

        // Ajusta StartsWith/Contains según cómo estén guardados los nombres
        return !string.IsNullOrWhiteSpace(nombre)
            && nombre.StartsWith(rol, StringComparison.OrdinalIgnoreCase);
    }

    public async Task PrintDocument()
    {
        string idiomaRuta   = idPais == 5 ? "en" : "es";
        string nombrePagina = idPais == 5 ? "TablePending" : "TablaPendientes";

        string lineaEnc = Uri.EscapeDataString(NombreLinea ?? "Todo");
        string estEnc   = Uri.EscapeDataString(Status ?? "Todo");

        // OJO: La ruta de esta página incluye /{accion}/{division}/{linea}/{f1}/{f2}/{tipo}/{est}
        string url = $"{idiomaRuta}/{nombrePagina}/{IdCentro}/{IdDiv}/{lineaEnc}/{fecha1:dd-MM-yyyy}/{fecha2:dd-MM-yyyy}/{tipoconsulta}/{estEnc}";
        await IJS.InvokeAsync<object>("open", new object[] { url, "_blank" });
    }

    protected async Task BuscarLineas(ChangeEventArgs e)
    {
        IdDiv = int.Parse(e.Value.ToString());
        try
        {
            if (IdDiv != 0)
            {
                MaestraData.lineas = await MaestraData.ObtenerLasLineasPorDivision(IdDiv);
            }
        }
        catch (Exception ex)
        {
            NotificationService.Notify(Notificar.Notificacion("error", "Error", DiccionarioTraduccionesService.Traducciones["SLinea"]));
        }
    }

    private void SeleccionarLinea(int valor)
    {
        LineaSeleccionada = valor;

        if (LineaSeleccionada == 0)
        {
            IdMasterSeleccionado = 0;
            NombreLinea = "Todo";
        }
        else
        {
            var lineaSeleccionada = MaestraData.lineas.FirstOrDefault(x => x.IdLinea == LineaSeleccionada);
            IdMasterSeleccionado = lineaSeleccionada?.IdMaster ?? 0;
            NombreLinea = lineaSeleccionada?.Linea ?? "Todo";
        }
    }

    private async Task OnLineaChanged(int valor)
    {
        LineaSeleccionada = valor;

        if (LineaSeleccionada == 0)
        {
            IdMasterSeleccionado = 0;
            NombreLinea = "Todo";
        }
        else
        {
            var lineaSeleccionada = MaestraData.lineas.FirstOrDefault(x => x.IdLinea == LineaSeleccionada);
            IdMasterSeleccionado = lineaSeleccionada?.IdMaster ?? 0;
            NombreLinea = lineaSeleccionada?.Linea ?? "Todo";
        }

        await Get();
    }
}