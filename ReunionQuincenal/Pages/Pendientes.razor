    private bool EsOpcionTotalPendiente(string? s)
    {
        // Trabaja SIEMPRE con clave canónica
        var canonico = ValidationMessages.MapStatusKey((s ?? string.Empty).Trim());

        // Acepta también variantes legadas o traducidas por si llegan desde la ruta o UI sin normalizar
        if (canonico.Equals("TotalPendiente", StringComparison.OrdinalIgnoreCase))
            return true;

        var valor = (s ?? string.Empty).Trim();
        var tieneDic = DiccionarioTraduccionesService.Traducciones != null
                    && DiccionarioTraduccionesService.Traducciones.ContainsKey("TotalPendiente");
        var traducidoTP = tieneDic
            ? DiccionarioTraduccionesService.Traducciones["TotalPendiente"]
            : "Total Pendiente";

        return valor.Equals("Total Pendiente", StringComparison.OrdinalIgnoreCase)
            || valor.Equals("Total Pending", StringComparison.OrdinalIgnoreCase)
            || valor.Equals(traducidoTP, StringComparison.OrdinalIgnoreCase);
    }

    private bool EsPendiente(string? estado)
