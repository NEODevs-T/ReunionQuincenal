    bool EsVencido(DateTime fechaTrabajo, string? estadoOriginal)
    {
        // Ignorar fechas no establecidas (DateTime.MinValue)
        if (fechaTrabajo == default) return false;

        var hoy = DateTime.Now.Date;
        var estadoCanonico = ValidationMessages.MapStatusKey(estadoOriginal ?? string.Empty);

        // "Abierto" = cualquier estado distinto de Listo/Cerrado
        var abierto = !(estadoCanonico.Equals("Listo", StringComparison.OrdinalIgnoreCase)
                    || estadoCanonico.Equals("Cerrado", StringComparison.OrdinalIgnoreCase));

        return fechaTrabajo.Date < hoy && abierto;
    }

