@page "/es/porcentajeasistencia"
@page "/en/attendancepercentage"

@using Radzen
@using System.Linq
@inject IMaestraData MaestraData
@inject IAsistenciaReuData AsistenciaReuData
@inject AuthenticationStateProvider AuthStateProvider
@inject ICargoReuData CargoReuData
@inject NotificationService NotificationService
@inject ILocalStorageService LocalStorage
@inject LocalizationService LocalizationService
@inject ITranslationService Translator
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService

@using ReunionWeb.Resources
@using System.Globalization
@using ReunionWeb.Services

@if (!traduccionesCargadas || dataIsLoaded == 1)
{
    <div class="loading-container">
        <div class="loader"></div>
    </div>
}
else
{
<h3>@DiccionarioTraduccionesService.Traducciones["PorcentajeDeAsistencia"]</h3>

<RadzenTemplateForm Data="@this">
    <RadzenRow>
             <RadzenColumn Width="200px">
            <RadzenLabel Text="@DiccionarioTraduccionesService.Traducciones["FechaInicial"]" />
            <RadzenDatePicker @bind-Value="mesAñoInicio" DateFormat="MM-yyyy" Style="width: 100%;" Max="@DateTime.Today" />
        </RadzenColumn>
        <RadzenColumn Width="200px">
            <RadzenLabel Text="@DiccionarioTraduccionesService.Traducciones["FechaFinal"]" />
            <RadzenDatePicker @bind-Value="mesAñoFin" DateFormat="MM-yyyy" Style="width: 100%;" Max="@DateTime.Today" />
        </RadzenColumn>
        <RadzenColumn Width="250px">
            <RadzenLabel Text="@DiccionarioTraduccionesService.Traducciones["Empresa"]" />
            <RadzenDropDown @bind-Value="empresa" Data="@empresas" TextProperty="Nombre" ValueProperty="Id" Style="width: 100%;" Placeholder="@DiccionarioTraduccionesService.Traducciones["SeleccioneUnaEmpresa"]"
                            Change="@(args => OnEmpresaChanged(args))" />
        </RadzenColumn>
        <RadzenColumn Width="250px">
            <RadzenLabel Text="@DiccionarioTraduccionesService.Traducciones["Centro"]" />
            <RadzenDropDown @bind-Value="area" Data="@areas" TextProperty="Nombre" ValueProperty="Id" Style="width: 100%;" Placeholder="@DiccionarioTraduccionesService.Traducciones["SeleccioneUnCentro"]" Disabled="@((string.IsNullOrEmpty(empresa)) || !areas.Any())" />
        </RadzenColumn>
        <RadzenColumn Width="150px" Style="display: flex; align-items: flex-start; padding-top: 30px;">
            <RadzenButton Text="@DiccionarioTraduccionesService.Traducciones["Consultar"]"
                    Click="@(async () => await Consultar())"
                    Style="width: 100%; background-color: #28a745; color: #ffffff;"
                    Icon="search"
                    Disabled="@(mesAñoInicio > mesAñoFin || mesAñoInicio == default || mesAñoFin == default || string.IsNullOrEmpty(empresa) || string.IsNullOrEmpty(area))" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenTemplateForm>
@if (dataIsLoaded == 1)
{
    <div class="loader"></div>
}
@if (dataIsLoaded == 2 && registros != null)
{
@if (registros != null && registros.Any())
{
    <RadzenLabel Text="@DiccionarioTraduccionesService.Traducciones["FiltrarPorCargo"]" Style="margin-right:10px;" />
    <RadzenTextBox @bind-Value="filtroCargo"
                    Placeholder="@DiccionarioTraduccionesService.Traducciones["BuscarCargo2"]"
                    Style="margin:15px 0 10px 0; width:250px;"
                    Change="@(args => FiltrarCargo())" />
    <RadzenButton Text="@DiccionarioTraduccionesService.Traducciones["BuscarCargo"]"
                    Icon="search"
                    ButtonStyle="ButtonStyle.Secondary"
                    Style="margin-bottom: 10px;"
                    Click="FiltrarCargo" />
}
@if (registros != null && registros.Any())
{
    <div style="margin-bottom:10px;">
    </div>
    @if (registrosFiltrados != null && !registrosFiltrados.Any() && !string.IsNullOrEmpty(filtroCargo))
    {
        <div style="color:red; margin-bottom:10px;">@DiccionarioTraduccionesService.Traducciones["NoExisteEseCargo"].</div>
    }
    <RadzenButton Text="@DiccionarioTraduccionesService.Traducciones["LimpiarFiltros"]"
                    Icon="refresh"
                    ButtonStyle="ButtonStyle.Secondary"
                    Style="margin-bottom: 10px;"
                    Click="LimpiarFiltros" />
    <RadzenDataGrid Data="@registrosFiltrados"
                    TItem="AsistenReuPorcetanjeDTO"
                    ShowPagingSummary="true"
                    PageSize="10"
                    Responsive="true"
                    AllowFiltering="false"
                    AllowSorting="true"
                    EmptyText="">
        <Columns>
            <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="Nombre" Title="@DiccionarioTraduccionesService.Traducciones["Cargo"]" Frozen="true" />
            <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="ReunionesProgramadas" Title="@DiccionarioTraduccionesService.Traducciones["ReunionesProgramadas"]" />
            <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="ReunionesAsistidas" Title="@DiccionarioTraduccionesService.Traducciones["ReunionesAsistidas"]">
                <FooterTemplate>
                    <b>
                        Total: @(registrosFiltrados?.Sum(x => x.ReunionesAsistidas) ?? 0)
                    </b>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="PorcentajeAsistencia" Title="@DiccionarioTraduccionesService.Traducciones["PorcentajeAsistencia"]">
                <FooterTemplate>
                    <b>@DiccionarioTraduccionesService.Traducciones["PorcentajeGlobal"]:</b>
                    <span 
                    style="color:@GetColor(porcentajeGlobal, true)">
                    @porcentajeGlobal.ToString("0.00")%
                    </span>
                    </FooterTemplate>
                <Template Context="data">
                    <span title="@DiccionarioTraduccionesService.Traducciones["PorcentajeAsistencia"]"
                        style="color:@GetColor(data.PorcentajeAsistencia, true); font-weight:bold;">
                        @data.PorcentajeAsistencia.ToString("0.00")%
                        @if (data.PorcentajeAsistencia >= 90)
                        {
                            <RadzenIcon Icon="check_circle" Style="color:green;vertical-align:middle;" />
                        }
                        else if (data.PorcentajeAsistencia < 60)
                        {
                            <RadzenIcon Icon="error" Style="color:red;vertical-align:middle;" />
                        }
                    </span>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="ReunionesSuplencias" Title="@DiccionarioTraduccionesService.Traducciones["ReunionesConSuplencias"]">
                <FooterTemplate>
                        <b>
                            Total: @(registrosFiltrados?.Sum(x => x.ReunionesSuplencias) ?? 0)
                        </b>
                    </FooterTemplate>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="PorcentajeSuplencia" Title="@DiccionarioTraduccionesService.Traducciones["PorcentajeSuplencia"]">
                    <FooterTemplate>
                    <b>@DiccionarioTraduccionesService.Traducciones["PorcentajeGlobal"]:</b>
                    <span 
                    style="color:@GetColor(porcentajeSuplencia, false)">
                    @porcentajeSuplencia.ToString("0.00")%
                    </span>
                    </FooterTemplate>
                    <Template Context="data">
                        <span title="@DiccionarioTraduccionesService.Traducciones["PorcentajeSuplencia"]"
                                style="color:@GetColor(data.PorcentajeSuplencia, false); font-weight:bold;">
                            @data.PorcentajeSuplencia.ToString("0.00")%
                            @if (data.PorcentajeSuplencia >= 90)
                            {
                                <RadzenIcon Icon="error" Style="color:red;vertical-align:middle;" />
                            }
                            else if (data.PorcentajeSuplencia < 60)
                            {
                                <RadzenIcon Icon="check_circle" Style="color:rgb(112, 143, 112);vertical-align:middle;" />
                            }
                        </span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
    else if (registros != null)
    {
        <div style="margin-top:20px;">@DiccionarioTraduccionesService.Traducciones["NoHayFiltros"]</div>
    }
}    
}
@code {
                [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private int idPais { get; set; }
    private DateTime mesAñoInicio = DateTime.Now;
    private DateTime mesAñoFin = DateTime.Now;
    public string area { get; set; } = "";
    public string empresa { get; set; } = "";
    private string filtroCargo = "";
    private List<AsistenReuPorcetanjeDTO> registrosFiltrados = new();
    private List<AsistenReuPorcetanjeDTO> registros = new();
    private double porcentajeGlobal = 0;
    private double porcentajeSuplencia = 0;
    private List<Empresa> empresas = new();
    private List<Area> areas = new();
    private List<CarReuDTO> cargosReunion = new();
    private int dataIsLoaded = 0;
    private List<Claim> claims = new();
    private bool traduccionesCargadas = false;
    private string rolUsuario = "";
    private string empresaUsuario = "";     
    private string idEmpresaUsuario = "";  
    private string idCentroUsuario = ""; 

     private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = user.Claims.ToList();

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
        
        rolUsuario = claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value ?? "";

        empresaUsuario = claims.FirstOrDefault(c =>
                c.Type == "Empresa" ||
                (c.Type.Contains("Empresa") && !c.Type.Contains("IdEmpresa")))
            ?.Value ?? "";

        idEmpresaUsuario = claims.FirstOrDefault(c =>
                c.Type == "IdEmpresa" || c.Type.Contains("IdEmpresa"))
            ?.Value ?? "";

        idCentroUsuario = claims.FirstOrDefault(c =>
                c.Type == "IdCentro" || c.Type.Contains("IdCentro"))
            ?.Value ?? "";
    }

    protected override async Task OnInitializedAsync()
    {
        await CreateData();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();

        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture ?? CultureInfo.InvariantCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture ?? CultureInfo.InvariantCulture;

        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;

        cargosReunion = await CargoReuData.GetCargosReunion();

        if (string.IsNullOrWhiteSpace(empresaUsuario))
        {
            empresas = cargosReunion
                .Where(c => !string.IsNullOrWhiteSpace(c.Empresa))
                .Select(c => c.Empresa.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(e => e)
                .Select(e => new Empresa { Id = e, Nombre = e })
                .ToList();
        }
        else
        {
            empresas = cargosReunion
                .Where(c => !string.IsNullOrWhiteSpace(c.Empresa) &&
                            string.Equals(c.Empresa.Trim(), empresaUsuario.Trim(), StringComparison.OrdinalIgnoreCase))
                .Select(c => c.Empresa.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(e => e)
                .Select(e => new Empresa { Id = e, Nombre = e })
                .ToList();
        }

        switch (rolUsuario)
        {
            case "Admin":
                await MaestraData.GetCentrosxEmpresa("All" + idEmpresaUsuario);
                break;

            default:
                await MaestraData.GetCentrosxEmpresa(idCentroUsuario);
                break;
        }

        areas = new List<Area>();

        if (empresas.Count == 1)
        {
            empresa = empresas.First().Id;
            OnEmpresaChanged(empresa);
        }
    }

    private void OnEmpresaChanged(object value)
    {
        empresa = value?.ToString() ?? "";
        area = "";

        if (string.IsNullOrWhiteSpace(empresa))
        {
            areas = new List<Area>();
            StateHasChanged();
            return;
        }

        var centrosPorEmpresa = cargosReunion
            .Where(c => !string.IsNullOrWhiteSpace(c.Empresa)
                    && string.Equals(c.Empresa.Trim(), empresa.Trim(), StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Centro?.Trim())
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var centrosPermitidos = MaestraData.centro
            .Select(c => c.Centro?.Trim())
            .Where(c => !string.IsNullOrWhiteSpace(c))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        areas = centrosPorEmpresa
            .Where(c => centrosPermitidos.Contains(c!))
            .OrderBy(c => c)
            .Select(c => new Area
            {
                Id = c!,
                Nombre = c!
            })
            .ToList();

        if (areas.Count == 1)
        {
            area = areas.First().Id;
        }

        StateHasChanged();
    }

    private async Task Consultar()
    {
        dataIsLoaded = 1;
        StateHasChanged();
        try
        {
            var response = await AsistenciaReuData.GetPorcentajeAsistenciaResponse(
                mesAñoInicio.ToString("MM-yyyy"),
                mesAñoFin.ToString("MM-yyyy"),
                empresa,
                area
        );
        registros = response?.DetallePorCargo ?? new List<AsistenReuPorcetanjeDTO>();
        porcentajeGlobal = response?.PorcentajeGlobal ?? 0;
        porcentajeSuplencia = response?.PorcentajeGlobalSuplencia ?? 0; 
        FiltrarCargo();
    }
    catch (Exception ex)
    {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "No se pudo obtener los datos: " + ex.Message);
        registros = new List<AsistenReuPorcetanjeDTO>();
        registrosFiltrados = new List<AsistenReuPorcetanjeDTO>();
        porcentajeGlobal = 0;
        porcentajeSuplencia = 0;
    }
        dataIsLoaded = 2;
        StateHasChanged();
}
private void FiltrarCargo()
{
    if (string.IsNullOrEmpty(filtroCargo))
    {
        registrosFiltrados = registros?.ToList() ?? new List<AsistenReuPorcetanjeDTO>();
    }
    else
    {
        registrosFiltrados = registros?
            .Where(x => x.Nombre.Contains(filtroCargo, StringComparison.OrdinalIgnoreCase))
            .ToList() ?? new List<AsistenReuPorcetanjeDTO>();
    }
}

void LimpiarFiltros()
{
    mesAñoInicio = DateTime.Today;
    mesAñoFin = DateTime.Today;
    empresa = string.Empty;
    area = string.Empty;
    filtroCargo = string.Empty;
    registros.Clear();
    registrosFiltrados.Clear();
    
    if (empresas.Count == 1)
    {
        empresa = empresas.First().Id;
        OnEmpresaChanged(empresa);
    }
    else
    {
        areas = new List<Area>();
    }
}
private string GetColor(double porcentaje, bool mayorEsMejor)
{
    if (mayorEsMejor)
    {
        if (porcentaje >= 90)
            return "green";
        else if (porcentaje >= 60)
            return "orange";
        else
            return "red";
    }
    else
    {
        if (porcentaje <= 60)
            return "green";
        else if (porcentaje <= 90)
            return "orange";
        else
            return "red";
    }
}
public class Empresa
{
    public string Id { get; set; } = string.Empty;
    public string Nombre { get; set; } = string.Empty;
}
public class Area
{
    public string Id { get; set; } = string.Empty;
    public string Nombre { get; set; } = string.Empty;
}


}
