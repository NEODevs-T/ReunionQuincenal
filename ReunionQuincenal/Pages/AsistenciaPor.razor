@page "/es/porcentajeasistencia"
@page "/en/attendancepercentage"

@using Radzen
@using System.Linq
@inject IAsistenciaReuData AsistenciaReuData
@inject AuthenticationStateProvider AuthStateProvider
@inject ICargoReuData CargoReuData
@inject NotificationService NotificationService
@inject ILocalStorageService LocalStorage

@using ReunionWeb.Resources
@using System.Globalization
@attribute [Authorize(Roles = "Admin, AdminChempro, SuperUser, PrimeUser, SemiAdmin, SuperAdmin")]

<h3>@ValidationMessages.PorcentajeDeAsistencia</h3>

<RadzenTemplateForm Data="@this">
    <RadzenRow>
             <RadzenColumn Width="200px">
            <RadzenLabel Text="@ValidationMessages.FechaInicial" />
            <RadzenDatePicker @bind-Value="mesAñoInicio" DateFormat="MM-yyyy" Style="width: 100%;" Max="@DateTime.Today" />
        </RadzenColumn>
        <RadzenColumn Width="200px">
            <RadzenLabel Text="@ValidationMessages.FechaFinal" />
            <RadzenDatePicker @bind-Value="mesAñoFin" DateFormat="MM-yyyy" Style="width: 100%;" Max="@DateTime.Today" />
        </RadzenColumn>
        <RadzenColumn Width="250px">
            <RadzenLabel Text="@ValidationMessages.Empresa" />
            <RadzenDropDown @bind-Value="empresa" Data="@empresas" TextProperty="Nombre" ValueProperty="Id" Style="width: 100%;" Placeholder="Seleccione una empresa"
                            Change="@(args => OnEmpresaChanged(args))" />
        </RadzenColumn>
        <RadzenColumn Width="250px">
            <RadzenLabel Text="@ValidationMessages.Area" />
            <RadzenDropDown @bind-Value="area" Data="@areas" TextProperty="Nombre" ValueProperty="Id" Style="width: 100%;" Placeholder="Seleccione un centro" Disabled="@((string.IsNullOrEmpty(empresa)) || !areas.Any())" />
        </RadzenColumn>
        <RadzenColumn Width="150px" Style="display: flex; align-items: flex-start; padding-top: 30px;">
            <RadzenButton Text="@ValidationMessages.Consultar"
                    Click="@(async () => await Consultar())"
                    Style="width: 100%; background-color: #28a745; color: #ffffff;"
                    Icon="search"
                    Disabled="@(mesAñoInicio > mesAñoFin || mesAñoInicio == default || mesAñoFin == default || string.IsNullOrEmpty(empresa) || string.IsNullOrEmpty(area))" />
            </RadzenColumn>
        </RadzenRow>
    </RadzenTemplateForm>
@if (dataIsLoaded == 1)
{
    <div class="loader"></div>
}
@if (dataIsLoaded == 2 && registros != null)
{
@if (registros != null && registros.Any())
{
    <RadzenLabel Text="@ValidationMessages.FiltrarPorCargo" Style="margin-right:10px;" />
    <RadzenTextBox @bind-Value="filtroCargo"
                    Placeholder="@ValidationMessages.BuscarCargo2"
                    Style="margin:15px 0 10px 0; width:250px;"
                    Change="@(args => FiltrarCargo())" />
    <RadzenButton Text="@ValidationMessages.BuscarCargo"
                    Icon="search"
                    ButtonStyle="ButtonStyle.Secondary"
                    Style="margin-bottom: 10px;"
                    Click="FiltrarCargo" />
}
@if (registros != null && registros.Any())
{
    <div style="margin-bottom:10px;">
        <b>@ValidationMessages.PorcentajeGlobal:</b>
        <span style="color:@GetColor(porcentajeGlobal)">
            @porcentajeGlobal.ToString("0.00")%
        </span>
    </div>
    @if (registrosFiltrados != null && !registrosFiltrados.Any() && !string.IsNullOrEmpty(filtroCargo))
    {
        <div style="color:red; margin-bottom:10px;">@ValidationMessages.NoExisteEseCargo.</div>
    }
    <RadzenButton Text="@ValidationMessages.LimpiarFiltros"
                    Icon="refresh"
                    ButtonStyle="ButtonStyle.Secondary"
                    Style="margin-bottom: 10px;"
                    Click="LimpiarFiltros" />
    <RadzenDataGrid Data="@registrosFiltrados"
                    TItem="AsistenReuPorcetanjeDTO"
                    ShowPagingSummary="true"
                    PageSize="10"
                    Responsive="true"
                    AllowFiltering="false"
                    AllowSorting="true"
                    EmptyText="">
        <Columns>
            <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="Nombre" Title="@ValidationMessages.Cargo" Frozen="true" />
            <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="ReunionesProgramadas" Title="@ValidationMessages.ReunionesProgramadas" />
            <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="ReunionesAsistidas" Title="@ValidationMessages.ReunionesAsistidas">
                <FooterTemplate>
                    <b>Total: @registrosFiltrados.Sum(x => x.ReunionesAsistidas)</b>
                </FooterTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AsistenReuPorcetanjeDTO" Property="PorcentajeAsistencia" Title="@ValidationMessages.PorcentajeAsistencia">
                <Template Context="data">
                    <span title="@ValidationMessages.PorcentajeAsistencia"
                        style="color:@GetColor(data.PorcentajeAsistencia); font-weight:bold;">
                        @data.PorcentajeAsistencia.ToString("0.00")%
                        @if (data.PorcentajeAsistencia >= 90)
                        {
                            <RadzenIcon Icon="check_circle" Style="color:green;vertical-align:middle;" />
                        }
                        else if (data.PorcentajeAsistencia < 60)
                        {
                            <RadzenIcon Icon="error" Style="color:red;vertical-align:middle;" />
                        }
                    </span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    }
    else if (registros != null)
    {
        <div style="margin-top:20px;">@ValidationMessages.NoHayFiltros</div>
    }
}    

@code {
                [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private int idPais { get; set; }
    private DateTime mesAñoInicio = DateTime.Now;
    private DateTime mesAñoFin = DateTime.Now;
    public string area { get; set; } = "";
    public string empresa { get; set; } = "";
    private string filtroCargo = "";
    private List<AsistenReuPorcetanjeDTO> registrosFiltrados = new();
    private List<AsistenReuPorcetanjeDTO> registros;
    private double porcentajeGlobal = 0;
    private List<Empresa> empresas = new();
    private List<Area> areas = new();
    private List<CarReuDTO> cargosReunion = new();
    private int dataIsLoaded = 0;
    private List<Claim> claims;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = user.Claims.ToList();
        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
            var culture = new System.Globalization.CultureInfo(paisTemp == 5 ? "en" : "es");
            System.Globalization.CultureInfo.DefaultThreadCurrentCulture = culture;
            System.Globalization.CultureInfo.DefaultThreadCurrentUICulture = culture;
            await LocalStorage.SetItemAsync("userCulture", culture.Name);
        }

        string? idEmpresaUsuario = claims.FirstOrDefault(c => c.Type.Contains("Empresa"))?.Value;

        cargosReunion = await CargoReuData.GetCargosReunion();

        empresas = cargosReunion
            .Where(c => c.Empresa.Contains(idEmpresaUsuario))
            .Select(c => c.Empresa)
            .Distinct()
            .Select(e => new Empresa { Id = e, Nombre = e })
            .ToList();

        areas = new List<Area>();
    }

    private void OnEmpresaChanged(object value)
    {
        empresa = value?.ToString() ?? "";
        area = "";
        if (string.IsNullOrEmpty(empresa))
        {
            areas = new List<Area>();
        }
        else
        {
            areas = cargosReunion
                .Where(c => c.Empresa == empresa)
                .Select(c => c.Centro)
                .Distinct()
                .Select(a => new Area { Id = a, Nombre = a })
                .ToList();
        }
        StateHasChanged();
    }

    private async Task Consultar()
    {
        dataIsLoaded = 1;
        StateHasChanged();
        try
        {
            var response = await AsistenciaReuData.GetPorcentajeAsistenciaResponse(
                mesAñoInicio.ToString("MM-yyyy"),
                mesAñoFin.ToString("MM-yyyy"),
                empresa,
                area
        );
        registros = response?.DetallePorCargo ?? new List<AsistenReuPorcetanjeDTO>();
        porcentajeGlobal = response?.PorcentajeGlobal ?? 0;
        FiltrarCargo();
    }
    catch (Exception ex)
    {
        NotificationService.Notify(NotificationSeverity.Error, "Error", "No se pudo obtener los datos: " + ex.Message);
        registros = new List<AsistenReuPorcetanjeDTO>();
        registrosFiltrados = new List<AsistenReuPorcetanjeDTO>();
        porcentajeGlobal = 0;
    }
        dataIsLoaded = 2;
        StateHasChanged();
}
private void FiltrarCargo()
{
    if (string.IsNullOrEmpty(filtroCargo))
    {
        registrosFiltrados = registros?.ToList() ?? new List<AsistenReuPorcetanjeDTO>();
    }
    else
    {
        registrosFiltrados = registros?
            .Where(x => x.Nombre.Contains(filtroCargo, StringComparison.OrdinalIgnoreCase))
            .ToList() ?? new List<AsistenReuPorcetanjeDTO>();
    }
}

void LimpiarFiltros()
{
    mesAñoInicio = DateTime.Today;
    mesAñoFin = DateTime.Today;
    empresa = string.Empty;
    area = string.Empty;
    filtroCargo = string.Empty;
    registros = null;
    registrosFiltrados = null;
}
private string GetColor(double porcentaje)
{
    if (porcentaje >= 90)
        return "green";
    else if (porcentaje >= 60)
        return "orange";
    else
        return "red";
}
public class Empresa
{
    public string Id { get; set; }
    public string Nombre { get; set; }
}
public class Area
{
    public string Id { get; set; }
    public string Nombre { get; set; }
}


}
