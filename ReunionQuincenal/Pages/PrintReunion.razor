@layout EmptyLayout
@page "/es/TablaReunion"
@page "/es/TablaReunion/{accion}/{division}/{f1}/{f2}/{tipo}"
@page "/en/TableMeeting"
@page "/en/TableMeeting/{accion}/{division}/{f1}/{f2}/{tipo}"

@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject IAsistenciaReuData AsistenciaReuData
@inject IAvisadorData AvisadorData
@inject ICargoReuData CargoReuData
@inject IKsfData KsfData
@inject IPizarraData PizarraData
@inject IRespoReuData RespoReuData
@inject IMaestraData MaestraData
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService
@inject LocalizationService LocalizationService
@inject ITranslationService Translator

@using ReunionWeb.Resources
@using System.Globalization
@using ReunionWeb.Services


@if (!traduccionesCargadas || dataIsLoaded == 1)
{
    <div class="loading-container"><div class="loader"></div></div>
}
else
{
    <div class="print-wrapper">
        @if (PizarraData.reudiatablas?.Count() > 0 && dataIsLoaded == 2)
        {

        <BSTable IsStriped="true" IsBordered="true">
            <BSTHead Class="cabecera">
                <BSTR>

                    @*<BSTD>Id</BSTD>*@
                    @*Centro para validar el comedor*@
                    @if (CentroComedor == 11)
                    {
                        <BSTD>@DiccionarioTraduccionesService.Traducciones["NEquipo"]</BSTD>
                    }
                    else
                    {

                        @*  <BSTD>División</BSTD>*@
                        <BSTD>@DiccionarioTraduccionesService.Traducciones["Area"]</BSTD>
                        <BSTD>Ksf</BSTD>

                    }

                    <BSTD>@DiccionarioTraduccionesService.Traducciones["CodigoDeEquipo"]</BSTD>
                    <BSTD ColSpan="4">@DiccionarioTraduccionesService.Traducciones["Discrepancia"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Codigo"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["PlanDeAccion"]</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Tiempo"]</BSTD>
                    <BSTD ColSpan="1">@DiccionarioTraduccionesService.Traducciones["Responsable"]</BSTD>
                    <BSTD>Status</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["Requisicion"]</BSTD>
                    <BSTD>ODT</BSTD>
                    <BSTD>@DiccionarioTraduccionesService.Traducciones["FechaDeTrabajo"]</BSTD>@*Fecha de listo el trabajo*@


                </BSTR>
            </BSTHead>
            <BSTBody>
                @foreach (var d in PizarraData.reudiatablas)
                {
                    @if ((d.Rdstatus != "Listo" && d.RdfecTra <= DateTime.Now) || (d.Rdstatus != "Listo" && string.IsNullOrEmpty(d.Rdodt)))

                    //@if (d.Rdstatus != "Listo")
                    {


                        <BSTR>

                            @*<BSTD>@d.IdReuDia</BSTD>*@
                            @*Centro para validar el comedor*@
                            @if (CentroComedor == 11)
                            {
                                @if (equiposlinea.Any(e => e.CodigoEq == d.RdcodEq) is true)
                                {


                                    @foreach (var eq in equiposlinea)
                                    {

                                        if (eq.CodigoEq == d.RdcodEq)
                                        {
                                            <BSTD>@eq.Equipo</BSTD>

                                        }


                                    }
                                }
                                else
                                {
                                    <BSTD>@DiccionarioTraduccionesService.Traducciones["NoHayDescrip"]</BSTD>

                                }

                            }
                            else
                            {
                                @*  <BSTD>@d.Rddiv</BSTD>*@
                                <BSTD>@d.Rdarea</BSTD>
                                <BSTD>
                                @{
                                    var texto = idPais == 5 
                                    ? KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfEnglish 
                                    : KsfData.ksfs.Where(x => x.Idksf == d.Idksf).FirstOrDefault()?.KsfNombre;
                                }
                                @texto</BSTD>
                            }
                            <BSTD>@d.RdcodEq</BSTD>
                            <BSTD ColSpan="4">@(d.Rddisc?.ToUpperInvariant() ?? string.Empty)</BSTD>
                            <BSTD>@d.RdcodDis</BSTD>
                            @if (@d.RdplanAcc is not null)
                            {
                                <BSTD Class="textotabla listo">@d.RdplanAcc</BSTD>
                            }
                            else
                            {
                                <BSTD Class="textotabla ">@d.RdplanAcc</BSTD>
                            }
                            <BSTD>@d.Rdtiempo</BSTD>
                            @{
                                var responsable = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == d.IdResReu);
                                var nombreResponsable = idPais == 5 
                                    ? responsable?.Rrenglish 
                                    : responsable?.Rrnombre ?? string.Empty;
                                }
                            <BSTD class="@(nombreResponsable == "Por Definir" ? "Definir" : "")">@nombreResponsable</BSTD>
                            @{
                                var estadoTraducido = d.Rdstatus switch
                                {
                                    "Listo" => idPais == 5 ? "Ready" : "Listo",
                                    "Cerrado" => idPais == 5 ? "Closed" : "Cerrado",
                                    _ => idPais == 5 ? "Pending" : "Pendiente"
                                };

                                var claseEstado = d.Rdstatus switch
                                {
                                    "Listo" => "listo",
                                    "Cerrado" => "Cerrado",
                                    _ => "pendiente"
                                };

                                var codRequiTexto = d.RdcodRequi == null ? "N/A" : d.RdcodRequi;
                            }
                            <BSTD Class="@claseEstado">@estadoTraducido</BSTD>
                                                        @if (d.RdcodRequi == null)
                            {
                                <BSTD>N/A</BSTD>
                            }
                            else
                            {
                                <BSTD>@d.RdcodRequi</BSTD>
                            }
                            <BSTD>@d.Rdodt</BSTD>
                            <BSTD>@d.RdfecTra.ToString("dd/MM/yyyy") </BSTD>


                        </BSTR>

                    }
                }


            </BSTBody>

        </BSTable>

    }
        <button type="button" onclick="window.print()" class="btn btn-success">
            <span class="oi oi-print"></span>
        </button>
    </div>
}



@code {

    [Parameter]
    public string? accion { get; set; }//centro
    [Parameter]
    public string? division { get; set; }//division
    [Parameter]
    public string? f1 { get; set; }
    [Parameter]
    public string? f2 { get; set; }
    [Parameter]
    public string? tipo { get; set; }

    private List<AsistenReuDTO> listaAsistencia { get; set; } = new();
    private List<LineaDTO> lineas { get; set; } = new();
    private List<DivisionDTO> divisions { get; set; } = new();
    private List<MaestraVDTO> centro { get; set; } = new();
    private List<KsfDTO> ksfs { get; set; } = new();
    private List<RespoReuDTO> resporeu { get; set; } = new();
    private List<ReunionDTO> reunionditabla { get; set; } = new();
    private List<ReunionDTO> reudiatabla { get; set; } = new();
    private List<AsistenReuDTO> asistenreus { get; set; } = new();
    private List<CargoReuDTO> cargoreus { get; set; } = new();
    private List<StatsAsisDto> StatsAsisDtos { get; set; } = new();
    private List<EquiposEamVDTO> equipos { get; set; } = new();
    private List<EquiposEamVDTO> equiposlinea { get; set; } = new();
    private List<EquipoEamDTO> listaEqupis { get; set; } = new();
    private List<RegistroCambiosDTO> listaRegistro { get; set; } = new();
    private List<CalendarioTrabajoDTO> calentrabajo { get; set; } = new();
    private List<CambFecDTO> cambiofecha { get; set; } = new();
    private List<ReunionDTO> reudiatablas { get; set; } = new();
    private int idPais { get; set; }
    private List<Claim> claims { get; set; } = new();
    int dataIsLoaded = 0;
    int CentroComedor = 0;
    private bool traduccionesCargadas = false;
    private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = Enumerable.ToList(user.Claims);

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
        else
        {
            // fallback
            try
            {
                idPais = await LocalStorage.GetItemAsync<int>("idPais");
            }
            catch { /* ignora */ }

            if (idPais == 0)
                idPais = 1; // Español por defecto
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CreateData();
        await KsfData.Getksf();
        await RespoReuData.GetResReu();
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture ?? CultureInfo.InvariantCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture ?? CultureInfo.InvariantCulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;
    }
    
    protected override async Task OnParametersSetAsync()
    {
        if (accion != null)
        {
            dataIsLoaded = 1;

            DateTime desde = DateTime.Now.AddDays(-1);
            DateTime hasta = DateTime.Now;

            if (!string.IsNullOrWhiteSpace(f1))
                DateTime.TryParseExact(f1, "dd-MM-yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out desde);
            if (!string.IsNullOrWhiteSpace(f2))
                DateTime.TryParseExact(f2, "dd-MM-yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out hasta);

            var idCentro = accion;
            var idDivision = division ?? string.Empty;
            var tipoConsulta = tipo ?? string.Empty;

            // 3) Llamada segura al backend
            PizarraData.reudiatablas = await PizarraData.GetPendientes(
                idCentro,
                idDivision,
                desde,
                hasta,
                tipoConsulta,
                "Reunion"
            ) ?? new List<ReunionDTO>();

            dataIsLoaded = 2;

            foreach (var e in PizarraData.reudiatablas)
            {
                e.Ksf = KsfData.ksfs.FirstOrDefault(x => x.Idksf == e.Idksf)?.KsfNombre;
                e.Responsable = RespoReuData.resporeus.FirstOrDefault(x => x.IdResReu == e.IdResReu)?.Rrnombre;
            }
        }
    }

}