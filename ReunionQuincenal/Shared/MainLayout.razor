@code {


    [CascadingParameter]
    private List<Claim> claims { get; set; }

    private string _message = "", mensaje = "";
    UserLoginDto user = new UserLoginDto();
    private bool carga = false;
    private NotifiRadzen Notificar = new NotifiRadzen();
    private int idioma  {get; set;} = 1;
    //private bool _buttonDisabled = true;
    //private BSAlert? _alertRef;
    protected override async Task OnInitializedAsync()
    {
        var cultureName = await LocalStorage.GetItemAsync<string>("userCulture") ?? "es";
        var culture = new CultureInfo(cultureName);
        CultureInfo.DefaultThreadCurrentCulture = culture;
        CultureInfo.DefaultThreadCurrentUICulture = culture;
    }

    protected async Task HandleLogin(EditContext e)
    {
        mensaje = "";
        user.Proyecto = "ReunionQuincenal";

        // Establecer cultura inicial según idioma seleccionado
        var culturaInicial = idioma == 1 ? "es" : "en";
        var culture = new CultureInfo(culturaInicial);
        CultureInfo.DefaultThreadCurrentCulture = culture;
        CultureInfo.DefaultThreadCurrentUICulture = culture;

        if (!e.Validate())
            return;

        carga = true;

        var result = await Http.PostAsJsonAsync("http://operaciones.papeleslatinos.com/AuthenticationP/api/Auth/Login", user);
        var ValidarToken = await result.Content.ReadAsStringAsync();

        if (string.IsNullOrEmpty(ValidarToken))
        {
            carga = false;
            return;
        }

        switch (ValidarToken)
        {
            case "NotFoundUser":
                mensaje = idioma == 1 ? "Verifique el usuario." : "Check the user.";
                NotificationService.Notify(Notificar.Notificacion("advertencia", idioma == 1 ? "Atención" : "Attention", mensaje));
                break;

            case "WrongPassword":
                mensaje = idioma == 1 ? "Contraseña Incorrecta." : "Check the password";
                NotificationService.Notify(Notificar.Notificacion("error", idioma == 1 ? "Atención" : "Attention", mensaje));
                break;

            case "null":
                mensaje = idioma == 1
                    ? "Este usuario no está registrado en este proyecto."
                    : "This user isn't registered in this project.";
                NotificationService.Notify(Notificar.Notificacion("error", idioma == 1 ? "Atención" : "Attention", mensaje));
                break;

            default:
                // Token válido: guardar y aplicar cultura desde el claim
                await LocalStorage.SetItemAsync("ReunionQuincenalToken", ValidarToken);

                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var userA = authState.User;
                claims = userA.Claims.ToList();

                var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
                string cultureName = "es"; // valor por defecto

                if (int.TryParse(idPaisClaim, out int paisTemp))
                {
                    cultureName = paisTemp == 5 ? "en" : "es";
                }

                var culturaFinal = new CultureInfo(cultureName);
                CultureInfo.DefaultThreadCurrentCulture = culturaFinal;
                CultureInfo.DefaultThreadCurrentUICulture = culturaFinal;

                await LocalStorage.SetItemAsync("userCulture", cultureName);

                user = new UserLoginDto();
                mensaje = "";
                string homeUrl = cultureName == "en"
                    ? $"{NavigationManager.BaseUri}en/home"
                    : $"{NavigationManager.BaseUri}es/inicio";

                NavigationManager.NavigateTo(homeUrl);
                break;
        }

        carga = false;
    }

}