@inject NavigationManager NavigationManager
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject IDiccionarioTraduccionesService DiccionarioTraduccionesService
@inject LocalizationService LocalizationService
@inject ITranslationService Translator

@using ReunionWeb.Resources
@using System.Globalization
@using ReunionWeb.Services


@if (!traduccionesCargadas || dataIsLoaded == 1)
{

}
else
{
<AuthorizeView>
    <Authorized>
       <strong>¡@DiccionarioTraduccionesService.Traducciones["Hola"] @context.User.Identity?.Name!</strong> 
         <BSButton   Color="BSColor.Danger"  Size="Size.ExtraSmall" OnClick="Logout">  @DiccionarioTraduccionesService.Traducciones["CerrarSesion"] <span class="oi oi-out"></span></BSButton>
    </Authorized>
    <NotAuthorized>
                 <BSButton   Color="BSColor.Success"  Size="Size.ExtraSmall" OnClick="Login">  @DiccionarioTraduccionesService.Traducciones["IniciarSesion"] <span class="oi oi-in"></span></BSButton>

    </NotAuthorized>
</AuthorizeView>
}

@code {
                [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    private int idPais { get; set; }
    private List<Claim> claims { get; set; } = new();

    private bool traduccionesCargadas = false;
    private int dataIsLoaded = 0;


    private async Task CreateData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        claims = user.Claims.ToList();

        var idPaisClaim = claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;
        if (int.TryParse(idPaisClaim, out int paisTemp))
        {
            idPais = paisTemp;
        }
    }

        protected override async Task OnInitializedAsync()
    {
        await CreateData();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        await LocalizationService.EstablecerCulturaDesdeTokenAsync();
        CultureInfo.CurrentCulture = CultureInfo.DefaultThreadCurrentCulture ?? CultureInfo.InvariantCulture;
        CultureInfo.CurrentUICulture = CultureInfo.DefaultThreadCurrentUICulture ?? CultureInfo.InvariantCulture;
        await DiccionarioTraduccionesService.CargarTraduccionesAsync();
        traduccionesCargadas = true;
    }

    void Login()
    {
        NavigationManager.NavigateTo("login");
    }

    async Task Logout()
    {
    await LocalStorage.RemoveItemAsync("OdtValue");
    await LocalStorage.RemoveItemAsync("ReunionQuincenalToken");

    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
    var user = authState.User;

    var idPaisClaim = user.Claims.FirstOrDefault(c => c.Type == "IdPais")?.Value;

    string cultureName = "es"; // valor por defecto
    if (int.TryParse(idPaisClaim, out int paisTemp))
    {
        cultureName = paisTemp == 5 ? "en" : "es";
    }

    string redirectUrl = cultureName == "en"
        ? $"{NavigationManager.BaseUri}en/home"
        : $"{NavigationManager.BaseUri}es/inicio";

    NavigationManager.NavigateTo(redirectUrl, forceLoad: true);
    }
}